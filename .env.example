# Chaves opcionais para importar animais das APIs externas.
# O projeto funciona sem elas usando os animais locais do seed.
REACT_APP_DOG_API_KEY=sua_chave_dog_api
REACT_APP_CAT_API_KEY=sua_chave_cat_api

# JWT usado pelo backend para assinar e validar tokens.
# Troque por um valor longo e secreto no seu .env real.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=1d

# Limite de requisicoes por janela de 15 minutos.
# Valor maior facilita a demonstracao e os testes de carga locais.
RATE_LIMIT_MAX=5000

# Usuario admin inicial criado automaticamente pelo backend.
# Use apenas como exemplo local; troque a senha no .env real.
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@adote.local
ADMIN_PASSWORD=admin123
