{
  "name": "adote-um-amigo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "start": "npm run dev",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "start:frontend": "npm --prefix frontend start",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "npm --prefix frontend start",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "backend:up": "docker compose up --build",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f",
    "backend:seed": "docker compose exec backend npm run seed",
    "load:animals": "docker compose --profile load-test run --rm k6 run /scripts/animals-list.js",
    "load:adoption": "docker compose --profile load-test run --rm k6 run /scripts/adoption-flow.js",
    "load:test": "npm run load:animals"
  }
}
